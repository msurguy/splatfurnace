{
  "name": "splatfurnace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "splatfurnace": "dist-cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "npm run build:cli && node dist-cli/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "build:xatlas": "./scripts/build-xatlas.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@sparkjsdev/spark": "^2.4.0",
    "lucide": "^1.65.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "webgpu": "^0.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "gltf-validator": "2.0.0-dev.3.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
