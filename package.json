{
  "name": "splatfurnace",
  "version": "0.1.0",
  "description": "Gaussian-splat PLY to low-poly, textured glTF on WebGPU, from the command line (Dawn) or in the browser",
  "keywords": [
    "gaussian-splatting",
    "3dgs",
    "splat",
    "ply",
    "gltf",
    "glb",
    "mesh",
    "webgpu",
    "photogrammetry",
    "cli"
  ],
  "homepage": "https://msurguy.github.io/splatfurnace/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msurguy/splatfurnace.git"
  },
  "bugs": "https://github.com/msurguy/splatfurnace/issues",
  "author": "Maksim Surguy",
  "license": "MIT",
  "type": "module",
  "bin": {
    "splatfurnace": "dist-cli/index.js"
  },
  "files": [
    "dist-cli"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "npm run build:cli && node dist-cli/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "build:xatlas": "./scripts/build-xatlas.sh",
    "prepublishOnly": "npm run typecheck && npm run build:cli"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "webgpu": "^0.6.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sparkjsdev/spark": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "gltf-validator": "2.0.0-dev.3.10",
    "lucide": "^1.65.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
